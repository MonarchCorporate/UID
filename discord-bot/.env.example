DISCORD_BOT_TOKEN=
# Bot-Token aus dem Discord Developer Portal (bereits im Lovable-Projekt als Secret hinterlegt)

DISCORD_GUILD_ID=1533457490958614699
# ID des Discord-Servers (keine Geheiminfo, im Backend identisch hinterlegt)

BACKOFFICE_URL=https://uid.sc
# URL der Backoffice-Instanz, an die der Bot Events meldet

HOOK_SECRET=
# Shared Secret zwischen Bot und Backoffice (bereits im Lovable-Projekt als Secret hinterlegt)
# Muss exakt mit dem Wert im Backend übereinstimmen

TRACK_MESSAGES=true
# true (Standard) = zählt Nachrichten-Metadaten (nur Länge/Zeitpunkt, keine Inhalte)

PRESENCE_TEXT=
# Optional: Startstatus des Bots, z.B. "UID Backoffice online"

HEARTBEAT_SECONDS=30
# Abstand der Heartbeats ans Backoffice (mindestens 15 empfohlen)
